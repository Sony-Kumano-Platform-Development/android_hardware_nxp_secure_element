cc_binary {
    name: "android.hardware.secure_element-service.pn8x",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.secure_element-service.pn8x.rc"],
    vintf_fragments: ["android.hardware.secure_element-service.pn8x.xml"],
    srcs: [
        "service.cpp",
        "SecureElement.cpp",
    ],
    shared_libs: [
        "android.hardware.secure_element-V1-ndk",
        "ese_spi_nxp_direct",
        "libbase",
        "libbinder_ndk",
        "ls_client_direct",
        "liblog",
    ],
    include_dirs: [
        "hardware/nxp/secure_element/pn8x/libese-spi/common/include",
        "hardware/nxp/secure_element/pn8x/libese-spi/p73/common",
        "hardware/nxp/secure_element/pn8x/libese-spi/p73/inc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
